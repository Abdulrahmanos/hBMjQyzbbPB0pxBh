[Unit]
Description=Bitcoin prospective paper week
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bitcoin
ExecStart=/usr/bin/docker compose -f compose.evaluation.yaml up -d --no-build
ExecStop=/usr/bin/docker compose -f compose.evaluation.yaml stop
TimeoutStartSec=120
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
